@{
    ViewData["Title"] = "Error";
}

<section class="section text-center">
    <div class="container">
        <i class="fa-solid fa-triangle-exclamation" style="font-size:4rem;color:#0d3b66;"></i>
        <h1 class="section-title mt-3">Oops! Something Went Wrong</h1>
        <p class="section-subtitle">We're sorry, an unexpected error occurred while processing your request.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-hero-primary mt-3">
            <i class="fa-solid fa-house me-2"></i>Back to Home
        </a>
    </div>
</section>
