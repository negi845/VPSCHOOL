@model ContactFormModel
@{
    ViewData["Title"] = "Contact Us";
}

<!-- Page Header -->
<section class="page-header">
    <div class="container">
        <h1>Contact Us</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Contact</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Contact Info Cards -->
<section class="section pb-0">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="contact-info-card">
                    <div class="contact-info-icon"><i class="fa-solid fa-location-dot"></i></div>
                    <h6>Address</h6>
                    <p>@SchoolData.Address</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="contact-info-card">
                    <div class="contact-info-icon"><i class="fa-solid fa-phone"></i></div>
                    <h6>Phone</h6>
                    <p>@SchoolData.Phone1<br />@SchoolData.Phone2</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="contact-info-card">
                    <div class="contact-info-icon"><i class="fa-solid fa-envelope"></i></div>
                    <h6>Email</h6>
                    <p>@SchoolData.Email<br />@SchoolData.AdmissionEmail</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="contact-info-card">
                    <div class="contact-info-icon"><i class="fa-solid fa-clock"></i></div>
                    <h6>Opening Hours</h6>
                    <p>Mon - Fri: 8:00 AM - 2:30 PM<br />Sat: 8:00 AM - 12:30 PM</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Map + Form -->
<section class="section">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="map-placeholder map-placeholder-tall">
                    <iframe
                        title="Vikram Public School Location Map"
                            src="https://www.google.com/maps?q=Vikram+Public+School+Sangam+Vihar+New+Delhi+110080&output=embed"
                        width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy">
                    </iframe>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="contact-form-card">
                    <span class="section-tag">Send a Message</span>
                    <h3 class="section-title mb-3">Get In Touch With Us</h3>

                    @if (ViewBag.SubmissionSuccess == true)
                    {
                        <div class="alert alert-success-custom" role="alert">
                            <i class="fa-solid fa-circle-check me-2"></i>
                            Thank you! Your message has been received. Our team will contact you shortly.
                        </div>
                    }

                    <form asp-controller="Home" asp-action="Contact" method="post" id="contactForm" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label">Full Name</label>
                                <input asp-for="Name" class="form-control" placeholder="Enter your full name" required minlength="3" />
                                <div class="invalid-feedback">Please enter your name (minimum 3 characters).</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">Email Address</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email" required /> 
                                <div class="invalid-feedback">Please enter a valid email address.</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">Phone Number</label>
                                <input asp-for="Phone" type="tel" class="form-control" placeholder="Enter your phone number" required pattern="[0-9+ ]{10,15}" />
                                <div class="invalid-feedback">Please enter a valid phone number.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Subject</label>
                                <select class="form-select">
                                    <option selected>Admission Enquiry</option>
                                    <option>General Query</option>
                                    <option>Fee Structure</option>
                                    <option>Feedback</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label asp-for="Message" class="form-label">Message</label>
                                <textarea asp-for="Message" class="form-control" rows="5" placeholder="Write your message here..." required minlength="10"></textarea>
                                <div class="invalid-feedback">Please enter a message (minimum 10 characters).</div>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-hero-primary w-100">
                                    <i class="fa-solid fa-paper-plane me-2"></i>Submit Message
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
