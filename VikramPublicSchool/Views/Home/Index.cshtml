@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-overlay"></div>
    <img src="~/images/hero-school.jpg" alt="Vikram Public School Campus" class="hero-bg-img" />
    <div class="container hero-content">
        <span class="badge-pill"><i class="fa-solid fa-award"></i> Est. @SchoolData.EstablishedYear &bull; Sangam Vihar, New Delhi</span>
        <h1 class="hero-title">Welcome to <span>Vikram Public School</span></h1>
        <p class="hero-subtitle">@SchoolData.Tagline</p>
        <p class="hero-desc">
            Providing quality, value-based primary education from Nursery to Class 5 in the heart of Sangam Vihar,
            New Delhi. A safe, disciplined and nurturing environment where every child is encouraged to excel.
        </p>
        <div class="hero-buttons">
            <a asp-controller="Home" asp-action="Admission" class="btn btn-hero-primary">
                <i class="fa-solid fa-graduation-cap me-2"></i>Apply for Admission
            </a>
            <a asp-controller="Home" asp-action="About" class="btn btn-hero-secondary">
                <i class="fa-solid fa-circle-info me-2"></i>Learn More
            </a>
        </div>
    </div>
</section>

<!-- Admission Open Banner -->
<section class="admission-banner">
    <div class="container">
        <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <i class="fa-solid fa-bullhorn admission-icon"></i>
                <div>
                    <h4 class="mb-1">Admissions Open for Session 2026-27</h4>
                    <p class="mb-0">Nursery to Class 5 &bull; Limited Seats Available &bull; Apply Today</p>
                </div>
            </div>
            <a asp-controller="Home" asp-action="Admission" class="btn btn-light-outline">Enquire Now <i class="fa-solid fa-arrow-right ms-1"></i></a>
        </div>
    </div>
</section>

<!-- About Preview Section -->
<section class="section about-preview">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-6">
                <img src="~/images/about-school.jpg" alt="About Vikram Public School" class="img-fluid rounded-4 shadow-soft" />
            </div>
            <div class="col-lg-6">
                <span class="section-tag">About Our School</span>
                <h2 class="section-title">A Legacy of Excellence Since @SchoolData.EstablishedYear</h2>
                <p class="section-text">
                    Vikram Public School has been a trusted name in Sangam Vihar for quality education,
                    combining strong academics with co-curricular activities, sports and moral values.
                    Our experienced faculty and modern infrastructure ensure that every student receives
                    individual attention and the best possible start in life.
                </p>
                <ul class="about-points">
                    <li><i class="fa-solid fa-circle-check"></i> Recognized institution with a proven academic track record</li>
                    <li><i class="fa-solid fa-circle-check"></i> Focus on holistic development - academics, sports & values</li>
                    <li><i class="fa-solid fa-circle-check"></i> Safe, well-maintained and CCTV-monitored campus</li>
                </ul>
                <a asp-controller="Home" asp-action="About" class="btn btn-outline-primary-custom">Read Full Story</a>

                <div class="row g-3 mt-4">
                    <div class="col-4">
                        <div class="stat-box">
                            <h3>@SchoolData.TotalStudents</h3>
                            <span>Students</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-box">
                            <h3>@SchoolData.TotalTeachers</h3>
                            <span>Dedicated Teachers</span>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="stat-box">
                            <h3>@SchoolData.StudentTeacherRatio</h3>
                            <span>Student-Teacher Ratio</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Highlights Section -->
<section class="section highlights-section bg-light-blue">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-tag">Our Strengths</span>
            <h2 class="section-title">Why Vikram Public School</h2>
            <p class="section-subtitle">Everything your child needs to learn, grow and thrive under one roof.</p>
        </div>
        <div class="row g-4">
            @foreach (var item in SchoolData.Highlights)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="highlight-card">
                        <div class="highlight-icon"><i class="@item.Icon"></i></div>
                        <h5>@item.Title</h5>
                        <p>@item.Description</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Why Choose Us Section -->
<section class="section why-choose-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-tag">Our Promise</span>
            <h2 class="section-title">Why Parents Choose Us</h2>
        </div>
        <div class="row g-4">
            @foreach (var reason in SchoolData.WhyChooseUs)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="reason-card">
                        <div class="reason-icon"><i class="@reason.Icon"></i></div>
                        <div>
                            <h6>@reason.Title</h6>
                            <p>@reason.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Principal's Message -->
<section class="section principal-section bg-light-blue">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-4 text-center">
                <img src="~/images/principal.jpg" alt="Principal, Vikram Public School" class="img-fluid principal-img shadow-soft" />
            </div>
            <div class="col-lg-8">
                <span class="section-tag">Principal's Message</span>
                <h2 class="section-title">A Word from Our Principal</h2>
                <p class="principal-quote">
                    <i class="fa-solid fa-quote-left me-2"></i>
                    Every child who walks through our gates carries unlimited potential. At Vikram Public
                    School, our mission is to nurture that potential with patience, discipline and care -
                    helping each student become confident, responsible and compassionate individuals ready
                    to face the world.
                </p>
                <h6 class="principal-name mb-0">Mrs. Kavita Malhotra</h6>
                <span class="principal-role">Principal, Vikram Public School</span>
            </div>
        </div>
    </div>
</section>

<!-- Gallery Preview -->
<section class="section gallery-preview-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-tag">Campus Life</span>
            <h2 class="section-title">A Glimpse of Our School</h2>
        </div>
        <div class="row g-3">
            @foreach (var img in SchoolData.GalleryImages.Take(4))
            {
                <div class="col-lg-3 col-6">
                    <div class="gallery-thumb">
                        <img src="@img.ImageUrl" alt="@img.Title" class="img-fluid" />
                        <div class="gallery-thumb-overlay">
                            <span>@img.Title</span>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a asp-controller="Home" asp-action="Gallery" class="btn btn-outline-primary-custom">View Full Gallery</a>
        </div>
    </div>
</section>

<!-- Testimonials -->
<section class="section testimonial-section bg-navy">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-tag section-tag-light">Testimonials</span>
            <h2 class="section-title text-white">What Parents Say About Us</h2>
        </div>
        <div class="row g-4">
            @foreach (var t in SchoolData.Testimonials)
            {
                <div class="col-lg-3 col-md-6">
                    <div class="testimonial-card">
                        <div class="testimonial-rating">
                            @for (int i = 0; i < t.Rating; i++)
                            {
                                <i class="fa-solid fa-star"></i>
                            }
                        </div>
                        <p class="testimonial-message">"@t.Message"</p>
                        <div class="testimonial-author">
                            <img src="@t.ImageUrl" alt="@t.Name" />
                            <div>
                                <h6>@t.Name</h6>
                                <span>@t.Role</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Latest News -->
<section class="section news-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="section-tag">Stay Updated</span>
            <h2 class="section-title">Latest News & Events</h2>
        </div>
        <div class="row g-4">
            @foreach (var news in SchoolData.LatestNews)
            {
                <div class="col-lg-3 col-md-6">
                    <div class="news-card">
                        <div class="news-icon"><i class="@news.Icon"></i></div>
                        <span class="news-date">@news.Date</span>
                        <h6>@news.Title</h6>
                        <p>@news.Description</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Quick Contact + Map -->
<section class="section contact-map-section bg-light-blue">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-6">
                <span class="section-tag">Get In Touch</span>
                <h2 class="section-title">Visit Our Campus</h2>
                <p class="section-text mb-4">
                    We would love to show you around. Reach out to us for admissions, queries or a campus tour.
                </p>
                <div class="quick-contact-list">
                    <div class="quick-contact-item">
                        <i class="fa-solid fa-location-dot"></i>
                        <div><strong>Address</strong><span>@SchoolData.Address</span></div>
                    </div>
                    <div class="quick-contact-item">
                        <i class="fa-solid fa-phone"></i>
                        <div><strong>Phone</strong><span>@SchoolData.Phone1 / @SchoolData.Phone2</span></div>
                    </div>
                    <div class="quick-contact-item">
                        <i class="fa-solid fa-envelope"></i>
                        <div><strong>Email</strong><span>@SchoolData.Email</span></div>
                    </div>
                </div>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-primary-custom mt-3">Contact Us</a>
            </div>
            <div class="col-lg-6">
                <div class="map-placeholder">
                    <iframe
                        title="Vikram Public School Location Map"
                            src="https://www.google.com/maps?q=Vikram+Public+School+Sangam+Vihar+New+Delhi+110080&output=embed" 
                        width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</section>
