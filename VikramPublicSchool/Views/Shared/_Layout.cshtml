<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vikram Public School</title>
    <meta name="description" content="Vikram Public School, Sangam Vihar, New Delhi - Providing quality primary education from Nursery to Class 5 since @VikramPublicSchool.Models.SchoolData.EstablishedYear." />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- Top Info Bar -->
    <div class="top-bar d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="top-bar-item">
                <i class="fa-solid fa-location-dot"></i> @VikramPublicSchool.Models.SchoolData.Address
            </div>
            <div class="d-flex gap-4">
                <div class="top-bar-item"><i class="fa-solid fa-phone"></i> @VikramPublicSchool.Models.SchoolData.Phone1</div>
                <div class="top-bar-item"><i class="fa-solid fa-envelope"></i> @VikramPublicSchool.Models.SchoolData.Email</div>
                <div class="top-bar-social">
                    <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light sticky-top main-navbar" id="mainNavbar">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.jpg" alt="Vikram Public School Logo" class="brand-logo" />
                <span class="brand-text">
                    Vikram Public School
                    <small>Sangam Vihar, New Delhi</small>
                </span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Gallery">Gallery</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                    <li class="nav-item">
                        <a class="btn btn-admission ms-lg-2" asp-controller="Home" asp-action="Admission">
                            <i class="fa-solid fa-graduation-cap me-1"></i> Admission
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Page Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand d-flex align-items-center gap-2 mb-3">
                        <img src="~/images/logo.jpg" alt="Vikram Public School Logo" class="footer-logo" />
                        <span>Vikram Public School</span>
                    </div>
                    <p class="footer-text">
                        Committed to academic excellence and holistic development of every child since @SchoolData.EstablishedYear,
                        serving the Sangam Vihar community of New Delhi.
                    </p>
                    <div class="footer-social">
                        <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" aria-label="Twitter"><i class="fa-brands fa-twitter"></i></a>
                        <a href="#" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="footer-heading">Quick Links</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Home" asp-action="About">About School</a></li>
                        <li><a asp-controller="Home" asp-action="Gallery">Gallery</a></li>
                        <li><a asp-controller="Home" asp-action="Admission">Admission</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact Us</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-heading">Contact Info</h6>
                    <ul class="footer-contact">
                        <li><i class="fa-solid fa-location-dot"></i> @SchoolData.Address</li>
                        <li><i class="fa-solid fa-phone"></i> @SchoolData.Phone1</li>
                        <li><i class="fa-solid fa-envelope"></i> @SchoolData.Email</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-heading">School Timing</h6>
                    <ul class="footer-contact">
                        <li><i class="fa-solid fa-clock"></i> Mon - Fri: 8:00 AM - 2:30 PM</li>
                        <li><i class="fa-solid fa-clock"></i> Saturday: 8:00 AM - 12:30 PM</li>
                        <li><i class="fa-solid fa-clock"></i> Sunday: Closed</li>
                    </ul>
                </div>
            </div>
            <hr class="footer-divider" />
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 pb-4">
                <p class="mb-0 copyright-text">&copy; @DateTime.Now.Year Vikram Public School, Sangam Vihar. All Rights Reserved.</p>
                <p class="mb-0 copyright-text">Designed for academic demonstration purposes.</p>
            </div>
        </div>
    </footer>

    <!-- Back to top button -->
    <button id="backToTop" class="back-to-top" aria-label="Back to top">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Site JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
